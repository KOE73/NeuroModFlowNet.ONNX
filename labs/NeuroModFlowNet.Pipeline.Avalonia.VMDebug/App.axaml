<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NeuroModFlowNet.Pipeline.Avalonia.VMDebug.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <DockFluentTheme />
    <Style Selector="DragPreviewControl">
      <Setter Property="ShowContent" Value="False" />
    </Style>
  </Application.Styles>
</Application>
