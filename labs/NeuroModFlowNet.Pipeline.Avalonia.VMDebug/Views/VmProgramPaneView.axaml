<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NeuroModFlowNet.Pipeline.Avalonia.VMDebug.Views.VmProgramPaneView">
    <Grid RowDefinitions="*"
          Margin="4">
        <TextBox AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Text="{Binding VmProgramText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>
</UserControl>
