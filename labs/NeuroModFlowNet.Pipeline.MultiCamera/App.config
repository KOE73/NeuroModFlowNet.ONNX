<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings file="App.local.config">
    <add key="CudaBinPath"  value="C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.9\bin" />
    <add key="CudnnBinPath" value="C:\cuDNN\9.10.2.21_cuda12\bin" />
    <add key="TrtLibPath"   value="C:\TensorRT\TensorRT-10.12.0.36-cuda12.9\lib" />

    <!--
      Path to the multi-camera JSON config. Relative paths resolve against the working directory, then the
      executable directory. Override in App.local.config (git-ignored) or pass the path as the first CLI argument.
      RTSP URLs with credentials belong in a git-ignored *.local.txt file referenced as "@Cam1.local.txt".
    -->
    <add key="CamerasConfig" value="cameras.sample.json" />

    <!-- FFmpeg 9 shared build for sources with "decoder": "nvdec" (avcodec-63.dll, matches FFmpeg.AutoGen 9.x). -->
    <add key="FFmpegLibrariesPath" value="C:\ffmpeg\ffmpeg-9.0.2-full_build-shared\bin" />
  </appSettings>
</configuration>
