<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings file="App.local.config">
    <add key="CudaBinPath"  value="C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.9\bin" />
    <add key="CudnnBinPath" value="C:\cuDNN\9.10.2.21_cuda12\bin" />
    <add key="TrtLibPath"   value="C:\TensorRT\TensorRT-10.12.0.36-cuda12.9\lib" />

    <!--
      LabMode: SingleStream | MultiStream
        SingleStream  — one camera, one VM controller, OBB runs inside the VM program (original behaviour).
        MultiStream   — one camera fanned out to VmCount VM workers; OBB runs in the batch service.
    -->
    <add key="LabMode" value="SingleStream" />

    <!-- Camera index passed to OpenCV VideoCapture. 0 = first USB/built-in camera. -->
    <add key="CameraIndex" value="0" />

    <!-- Show OpenCV preview windows (source frame + per-VM output windows). -->
    <add key="ShowOpenCvWindows" value="true" />

    <!-- Throttle the camera read loop to the physical camera FPS. Disable for max throughput testing. -->
    <add key="SyncLoopToCameraFps" value="true" />

    <!--
      OBB model file name (without path; resolved via AssetsManager).
      Precision: fp16 | fp32
      UseByteBgr: true = model expects uint8 BGR input; false = normalised float input.
    -->
    <add key="ObbModelPrecision" value="fp16" />
    <add key="ObbModelUseByteBgr" value="true" />

    <!-- SingleStream only: max simultaneous in-flight pipeline runs. -->
    <add key="SingleStream.MaxInFlight" value="1" />

    <!--
      MultiStream only.
      VmCount      — number of emulated VM workers (each gets its own PipelineVmController).
      ObbBatchSize — frames accumulated per OBB inference run. Ideally equals VmCount.
      MaxInFlightPerVm — max in-flight pipeline runs per VM worker.
    -->
    <add key="MultiStream.VmCount"        value="4" />
    <add key="MultiStream.ObbBatchSize"   value="4" />
    <add key="MultiStream.MaxInFlightPerVm" value="1" />
  </appSettings>
</configuration>
