<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Configurations>Debug;Release</Configurations>
		<NoWarn>$(NoWarn);SYSLIB5001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.34.1" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.25.1" />
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260330" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" />
		<PackageReference Include="Spectre.Console" Version="0.55.2" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.7" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Onnx" />
		<Using Include="Google.Protobuf" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\NeuroModFlowNet.Pipeline\NeuroModFlowNet.Pipeline.csproj" />
		<ProjectReference Include="..\..\src\NeuroModFlowNet.Pipeline.ONNX\NeuroModFlowNet.Pipeline.ONNX.csproj" />
		<ProjectReference Include="..\..\src\NeuroModFlowNet.ONNX\NeuroModFlowNet.ONNX.csproj" />
		<ProjectReference Include="..\..\src\NeuroModFlowNet.ONNX.Graph\NeuroModFlowNet.ONNX.Graph.csproj" />
		<ProjectReference Include="..\..\samples\NeuroModFlowNet.ONNX.Demo.Assets\NeuroModFlowNet.ONNX.Demo.Assets.csproj" />
	</ItemGroup>

</Project>
